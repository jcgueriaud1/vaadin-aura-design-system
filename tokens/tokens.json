{
  "$description": "Aura design system base tokens (DTCG). Two layers: primitives and semantic tokens. Overlays must only alias/override the semantic layer, never primitives.",
  "color": {
    "$type": "color",
    "gray": {
      "50":  { "$value": "#fafafa" },
      "100": { "$value": "#f4f4f5" },
      "700": { "$value": "#3f3f46" },
      "900": { "$value": "#18181b" }
    },
    "blue": {
      "500": { "$value": "#3b82f6" },
      "600": { "$value": "#2563eb" }
    },
    "surface":    { "$value": "{color.gray.50}",  "$description": "semantic" },
    "text":       { "$value": "{color.gray.900}", "$description": "semantic" },
    "primary":    { "$value": "{color.blue.600}", "$description": "semantic" },
    "brand":      { "$value": "{color.primary}",  "$description": "semantic — typical overlay override target" }
  },
  "space": {
    "$type": "dimension",
    "100": { "$value": "0.25rem" },
    "200": { "$value": "0.5rem" },
    "400": { "$value": "1rem" },
    "card-padding": { "$value": "{space.400}", "$description": "semantic" }
  },
  "radius": {
    "$type": "dimension",
    "medium": { "$value": "0.375rem", "$description": "semantic" }
  },
  "font": {
    "family": {
      "base": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"], "$description": "semantic" }
    }
  }
}
