{
  "$description": "Aura design system base tokens (DTCG). Two layers: primitives and semantic tokens. Overlays must only alias/override the semantic layer, never primitives. Every token declares its layer in $extensions['com.vaadin.aura'].layer — group-level $extensions is NOT inherited by children, so the marker is required on each token individually and CI fails if one is missing.",
  "color": {
    "$type": "color",
    "gray": {
      "50":  { "$value": "#fafafa", "$extensions": { "com.vaadin.aura": { "layer": "primitive" } } },
      "100": { "$value": "#f4f4f5", "$extensions": { "com.vaadin.aura": { "layer": "primitive" } } },
      "700": { "$value": "#3f3f46", "$extensions": { "com.vaadin.aura": { "layer": "primitive" } } },
      "900": { "$value": "#18181b", "$extensions": { "com.vaadin.aura": { "layer": "primitive" } } }
    },
    "blue": {
      "500": { "$value": "#3b82f6", "$extensions": { "com.vaadin.aura": { "layer": "primitive" } } },
      "600": { "$value": "#2563eb", "$extensions": { "com.vaadin.aura": { "layer": "primitive" } } }
    },
    "surface": {
      "$value": "{color.gray.50}",
      "$description": "Default background surface for pages and cards.",
      "$extensions": { "com.vaadin.aura": { "layer": "semantic" } }
    },
    "text": {
      "$value": "{color.gray.900}",
      "$description": "Default body text colour on surface.",
      "$extensions": { "com.vaadin.aura": { "layer": "semantic" } }
    },
    "primary": {
      "$value": "{color.blue.600}",
      "$description": "Primary action colour: default buttons, links, focus.",
      "$extensions": { "com.vaadin.aura": { "layer": "semantic" } }
    },
    "brand": {
      "$value": "{color.primary}",
      "$description": "Application brand colour. Defaults to primary; the typical overlay override target.",
      "$extensions": { "com.vaadin.aura": { "layer": "semantic" } }
    }
  },
  "space": {
    "$type": "dimension",
    "100": { "$value": "0.25rem", "$extensions": { "com.vaadin.aura": { "layer": "primitive" } } },
    "200": { "$value": "0.5rem",  "$extensions": { "com.vaadin.aura": { "layer": "primitive" } } },
    "400": { "$value": "1rem",    "$extensions": { "com.vaadin.aura": { "layer": "primitive" } } },
    "card-padding": {
      "$value": "{space.400}",
      "$description": "Inner padding for card-like containers.",
      "$extensions": { "com.vaadin.aura": { "layer": "semantic" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "medium": {
      "$value": "0.375rem",
      "$description": "Default corner radius for controls and containers.",
      "$extensions": { "com.vaadin.aura": { "layer": "semantic" } }
    }
  },
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": ["Inter", "system-ui", "sans-serif"],
        "$description": "Default UI font stack.",
        "$extensions": { "com.vaadin.aura": { "layer": "semantic" } }
      }
    }
  }
}
